# LangGraph Agent Server (`langgraph dev`) — free key at https://smith.langchain.com/settings
LANGSMITH_API_KEY=

# Chat graph (Ollama default)
INFOVINCI_CHAT_MODEL=ollama:llama3.1:8b
INFOVINCI_CHAT_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Blog vector index (run `poetry run infovinci-embed-blogs` after changing posts)
# Set to 1 to disable blog RAG (faster, but answers come from the LLM only)
INFOVINCI_SKIP_RAG=0
INFOVINCI_VECTOR_DB_PATH=data/infovinci_chroma
INFOVINCI_VECTOR_COLLECTION=infovinci_blog_posts
INFOVINCI_EMBEDDING_MODEL=all-MiniLM-L12-v2
INFOVINCI_RETRIEVAL_COUNT=10

# FastAPI blog API
CHAT_BFF_HOST=127.0.0.1
CHAT_BFF_PORT=8080
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
